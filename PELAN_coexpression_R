#Averaging replicates
Exp_table_long_averaged <- Exp_table_long %>% 
  full_join(PCA_coord %>% 
              select(Run, tissue, stage), 
            by = c("library"="Run")) %>% 
  group_by(gene_ID, tissue, stage) %>% 
  summarise(mean.logTPM = mean(logTPM)) %>% 
  ungroup()  

